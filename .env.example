# ======================================================
# Copie este arquivo para ".env" e preencha os valores.
# O ".env" NUNCA deve ir para o GitHub.
# ======================================================

# development | production
NODE_ENV=development
PORT=3000

# URL pública do site (sem barra no final)
FRONTEND_URL=http://localhost:3000
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback

# GitHub -> Settings -> Developer settings -> OAuth Apps
GITHUB_CLIENT_ID=coloque_o_client_id_aqui
GITHUB_CLIENT_SECRET=coloque_o_client_secret_aqui

# Gere com:
#   node -p "require('crypto').randomBytes(48).toString('hex')"
# Em produção precisa ter 32+ caracteres.
SESSION_SECRET=troque_por_um_valor_aleatorio_longo

# Duração do login em dias (padrão 30)
SESSION_DAYS=30


# ------------------------------------------------------
# PRODUÇÃO (descomente e ajuste)
# ------------------------------------------------------

# Origens que podem chamar a API (separadas por vírgula).
# Padrão: a origem do FRONTEND_URL.
# ALLOWED_ORIGINS=https://seudominio.com

# Quantos proxies ficam na frente do Node (Render/Railway/Nginx = 1)
# TRUST_PROXY=1

# Redireciona HTTP -> HTTPS (deixe "false" só se o health check falhar)
# FORCE_HTTPS=true

# Store de sessão persistente (npm install connect-redis redis)
# REDIS_URL=redis://usuario:senha@host:6379